  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=80>Graphics Settings Window</size>\nEasy way to add <color=#00ff00>Graphics
    Settings</color> to your game, just drop the <color=#00ff00>Prefab</color>\nto
    allow the player to control lots of settings.\n\nDrop the <color=#00ff00>GraphicsSettingsUI</color>
    prefab inside a Canvas\nDrop the <color=#00ff00>GraphicsSettingsBootstrap</color>
    prefab in the scene so settings are applied\nas soon as the Scene opens\n\nAnd
    make sure to <color=#00ff00>assign the fields</color> in those two objects\nYou
    need to assign the Camera, Volume, and SSAO (optional)\n\nThen you can incorporate
    this inside a complete Options Menu \nwith your other game/audio/key settings"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
