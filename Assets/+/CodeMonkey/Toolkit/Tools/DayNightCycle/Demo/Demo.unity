      m_Calls: []
  m_text: "<size=80>Day Night Cycle</size>\nSimple Day Night Cycle keeping track
    of <color=#00ff00>time</color> (24 hours) and rotating the <color=#00ff00>sun</color>
    in the sky\nThere are <color=#00ff00>IsDayTime()</color> and <color=#00ff00>IsNightTime()</color>
    functions in case you want to do logic at <color=#00ff00>Day/Night</color>\n\nJust
    drag the <color=#00ff00>Prefab</color> onto a scene, \nand edit the <color=#00ff00>sun
    animation</color> if you want a different angle, \nand edit the <color=#00ff00>secondsPerDay</color>
    in the DayNightCycle script."
